# Copia este archivo a .env y rellena los valores reales.
#   copy .env.example .env
# Nunca subas .env al repositorio: ahí viven secretos.

# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- MongoDB local (Docker) ---
# Desde el host (API con npm run dev): usa localhost.
# Dentro de Compose (profile dev) docker-compose.yml sustituye el host por `mongo`.
MONGO_INITDB_ROOT_USERNAME=lectura
MONGO_INITDB_ROOT_PASSWORD=lectura
MONGODB_DB=lectura_activa
MONGODB_URI=mongodb://lectura:lectura@localhost:27017/lectura_activa?authSource=admin

# --- Supabase Auth ---
# URL y clave pública (anon) del proyecto. La anon key puede ir al cliente.
# SERVICE_ROLE y JWT_SECRET solo viven en el servidor (nunca en el frontend).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
ORIGIN_SHARED_SECRET=
REQUIRE_EDGE=false