# ============================================================
# Entorno
# ============================================================
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================================
# MongoDB
# ============================================================
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/lectura_activa?retryWrites=true&w=majority
MONGODB_DB=lectura_activa

# ============================================================
# Supabase (opcional en desarrollo)
# ============================================================
# Si no se rellenan, la API arranca y los endpoints protegidos
# devuelven 503 AUTH_NOT_CONFIGURED.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Hook de dominio
# ============================================================
# Secreto compartido con el hook before-user-created de Supabase.
# Generar con: openssl rand -hex 32
INTERNAL_HOOK_SECRET=dev-secret-0123456789abcdef0123456789abcdef

# ============================================================
# Analytics job
# ============================================================
# Secreto para el endpoint interno de jobs de analítica (Cloud Scheduler).
# Generar con: openssl rand -hex 32
ANALYTICS_JOB_SECRET=

# ============================================================
# Cookies
# ============================================================
# Secreto para firmar cookies (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32
COOKIE_SECRET=dev-cookie-secret-change-me-32chars

# ============================================================
# Frontend
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# CORS
# ============================================================
# Lista separada por comas de orígenes permitidos.
# En producción: https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Cloudflare Edge (opcional)
# ============================================================
# Secreto compartido con el Worker proxy de Cloudflare.
# Si no usas Cloudflare, dejar ORIGIN_SHARED_SECRET vacío y REQUIRE_EDGE=false.
# Generar con: openssl rand -hex 32
ORIGIN_SHARED_SECRET=
REQUIRE_EDGE=false

# ============================================================
# Mailer (reset-password)
# ============================================================
# 'console' = loguea el link en consola (dev).
# 'resend'  = envía correo real vía Resend (prod).
MAILER_MODE=console
RESEND_API_KEY=
MAILER_FROM=no-reply@lectura-activa.local

# ============================================================
# Reset password
# ============================================================
RESET_TOKEN_TTL_MINUTES=15