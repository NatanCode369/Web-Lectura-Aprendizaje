# ============================================================
# Entorno
# ============================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ============================================================
# MongoDB
# ============================================================
# Desarrollo local (Docker):
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lectura_activa

# Desarrollo con Atlas (recomendado si no tienes Docker):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ============================================================
# Supabase (opcional en desarrollo)
# ============================================================
# Si no se rellenan, la API arranca y los endpoints protegidos
# devuelven 503 AUTH_NOT_CONFIGURED.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido con el hook before-user-created de Supabase.
# Generar con: openssl rand -hex 32
INTERNAL_HOOK_SECRET=dev-secret-0123456789abcdef0123456789abcdef

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:5173